    "limen.summary.morning": {"class":"summary","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"none","title":"Limen morning snapshot","templates":{"summary":"Snapshot as of {snapshot_time}: {summary}"}},
    "limen.summary.midday": {"class":"summary","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"none","title":"Limen midday snapshot","templates":{"summary":"Snapshot as of {snapshot_time}: {summary}"}},
    "limen.shipping.threshold": {"class":"milestone","severity":"quiet","owner":"limen","privacy":"public-safe","channels":["macos"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"none","title":"Limen shipping milestone","templates":{"milestone":"Crossed {threshold}; {observed} observed at {snapshot_time}."}},
