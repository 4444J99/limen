    "limen.notification.canary": {"class":"diagnostic","severity":"quiet","owner":"limen","privacy":"public-safe","channels":["macos"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"none","title":"Limen notification canary","templates":{"milestone":"Notification {canary_mode} canary submitted at {snapshot_time}."}},
    "limen.host.pressure": {"class":"actionable","severity":"urgent","owner":"limen","privacy":"private","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"submitted_channels","title":"Limen host pressure","templates":{"onset":"Host pressure at {snapshot_time}: gate={gate_state}, restart_count={restart_count}.","clear":"Host pressure recovered at {snapshot_time}: gate={gate_state}, restart_count={restart_count}."}},
