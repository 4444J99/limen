    "limen.ci.provider_runner_admission": {"class":"integrity","severity":"urgent","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"submitted_channels","title":"Limen trunk CI","templates":{"onset":"A provider billing-related runner-admission annotation was observed for run {run_id}; account cause and remediation are unverified.","clear":"Required CI is green; the provider runner-admission observation cleared at {snapshot_time}."}},
    "limen.ci.quota": {"class":"actionable","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"submitted_channels","title":"Limen trunk CI","templates":{"onset":"GitHub reports an Actions quota gate for run {run_id}.","clear":"Required CI is green; the quota observation cleared at {snapshot_time}."}},
    "limen.ci.visibility_drift": {"class":"integrity","severity":"urgent","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"submitted_channels","title":"Limen trunk CI","templates":{"onset":"Repository visibility differs from its estate declaration for run {run_id}.","clear":"Required CI is green; the visibility-drift condition cleared at {snapshot_time}."}},
    "limen.ci.runner_startup_jam": {"class":"actionable","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"submitted_channels","title":"Limen trunk CI","templates":{"onset":"Unknown runner-startup jam for run {run_id}.","clear":"Required CI is green; the runner-startup condition cleared at {snapshot_time}."}},
    "limen.ci.code_failure": {"class":"actionable","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"submitted_channels","title":"Limen trunk CI","templates":{"onset":"Executed CI code failed for run {run_id}.","clear":"Required CI is green; the executed-code failure cleared at {snapshot_time}."}},
