    "limen.ci.code_failure": {"class":"actionable","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"delivered_channels","title":"Limen trunk CI","templates":{"onset":"Executed CI code failed for run {run_id}.","clear":"Required CI is green; the executed-code failure cleared at {snapshot_time}."}},
    "limen.ci.unknown": {"class":"integrity","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"delivered_channels","title":"Limen trunk CI","templates":{"onset":"CI failure for run {run_id} could not be classified.","clear":"Required CI is green; the unclassified condition cleared at {snapshot_time}."}}
