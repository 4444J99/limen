    "limen.ci.quota": {"class":"actionable","severity":"normal","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"delivered_channels","title":"Limen trunk CI","templates":{"onset":"GitHub reports an Actions quota gate for run {run_id}.","clear":"Required CI is green; the quota observation cleared at {snapshot_time}."}},
    "limen.ci.visibility_drift": {"class":"integrity","severity":"urgent","owner":"limen","privacy":"public-safe","channels":["macos","ntfy"],"dedupe_key":"{stable_id}:{subject_key}","recovery":"delivered_channels","title":"Limen trunk CI","templates":{"onset":"Repository visibility differs from its estate declaration for run {run_id}.","clear":"Required CI is green; the visibility-drift condition cleared at {snapshot_time}."}},
