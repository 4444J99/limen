{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.dev/schemas/NotificationEventV1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["event_id", "transition", "subject_key", "observed_at", "stable_id", "facts", "evidence_ref", "producer", "owner"],
  "properties": {
    "event_id": {"type": "string", "minLength": 1},
    "transition": {"enum": ["onset", "update", "clear", "summary", "milestone", "integrity", "diagnostic"]},
    "subject_key": {"type": "string", "minLength": 1},
    "observed_at": {"type": "string", "format": "date-time"},
    "stable_id": {"type": "string", "pattern": "^(limen|domus)\\."},
    "facts": {"type": "object", "additionalProperties": {"type": ["string", "number", "integer", "boolean", "null"]}},
    "evidence_ref": {"type": "string", "minLength": 1},
    "producer": {"type": "string", "minLength": 1},
    "owner": {"enum": ["limen", "domus-genoma"]}
  }
}
