    "prohibited_commitments": [
      "price",
      "availability",
      "acceptance",
      "signature",
      "send"
    ],
    "allowed_placeholders": ["name", "summary", "route"],
    "templates": {
      "client_acknowledgment": {
        "subject": "Draft acknowledgment: {summary}",
        "body": "Hello {name}, this is a draft acknowledgment for operator review. The request is queued for {route}."
      },
      "client_discovery": {
        "subject": "Draft discovery follow-up: {summary}",
        "body": "Hello {name}, this draft asks for a bounded discovery conversation about {summary}; an operator must review every detail."
      },
      "scheduling": {
        "subject": "Draft scheduling note: {summary}",
        "body": "Hello {name}, this draft proposes that an operator choose a time and channel before any scheduling message is sent."
      },
      "recruiter_acknowledgment": {
        "subject": "Draft recruiter acknowledgment: {summary}",
        "body": "Hello {name}, this draft records the role inquiry and routes it to {route} for manual review."
      },
      "operator_review": {
        "subject": "Draft operator review: {summary}",
        "body": "Operator review draft for {name}: inspect provenance and route {route} before preparing any reply."
      },
      "decline": {
        "subject": "Draft decline: {summary}",
        "body": "Draft decline for operator review only; do not transmit without separate authority."
      },
      "manual_review": {
        "subject": "Draft manual review: {summary}",
        "body": "Low-confidence draft for {name}; an operator must classify the request before any response is prepared."
      }
    }
  },
