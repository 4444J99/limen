{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.org/limen/positioning/p14/quarterly-decision.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "period_start", "evidence", "decision", "truth_finding", "prominence_finding", "next_experiment", "owner", "prior_strategy_version", "proposed_strategy_version"],
  "properties": {
    "schema_version": {"const": "limen.positioning_p14_quarterly_decision.v1"},
    "scope": {"enum": ["synthetic", "live"]},
    "period_start": {"type": "string", "format": "date"},
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["conversation", "funnel", "delivery", "claim"],
      "properties": {
        "conversation": {"$ref": "#/$defs/evidenceIds"},
        "funnel": {"$ref": "#/$defs/evidenceIds"},
        "delivery": {"$ref": "#/$defs/evidenceIds"},
        "claim": {"$ref": "#/$defs/evidenceIds"}
      }
    },
    "decision": {"enum": ["keep", "narrow", "promote", "withdraw"]},
    "truth_finding": {"type": "string", "minLength": 1},
    "prominence_finding": {"type": "string", "minLength": 1},
    "next_experiment": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "prior_strategy_version": {"type": "string", "minLength": 1},
    "proposed_strategy_version": {"type": "string", "minLength": 1},
    "evidence_url": {"type": "string", "pattern": "^https://"}
  },
  "$defs": {
    "evidenceIds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"}}
  }
}
