{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://organvm.org/limen/positioning/p14/claim-incident.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "scope", "claim", "surfaces", "correction", "restore_surfaces"],
  "properties": {
    "schema_version": {"const": "limen.positioning_p14_claim_incident.v1"},
    "scope": {"const": "synthetic"},
    "claim": {
      "type": "object", "additionalProperties": false,
      "required": ["claim_id", "version", "status"],
      "properties": {"claim_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "status": {"type": "string", "minLength": 1}}
    },
    "surfaces": {
      "type": "array", "minItems": 1,
      "items": {"type": "object", "additionalProperties": false, "required": ["surface_id", "published_claim_ids"], "properties": {"surface_id": {"type": "string", "minLength": 1}, "published_claim_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}}
    },
    "correction": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "status", "evidence_id"],
      "properties": {"version": {"type": "string", "minLength": 1}, "status": {"const": "verified"}, "evidence_id": {"type": "string", "minLength": 1}}
    },
    "restore_surfaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
