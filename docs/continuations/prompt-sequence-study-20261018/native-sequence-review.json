      "claim": "The same next-action question yields materially different operator actions as context changes, including a retraction. Preserve dynamic target resolution; do not encode a fixed action."
    },
    {
      "id": "payload-cannot-disappear",
      "evidence": [
        "S1.5",
        "S3.3",
        "S8.2",
        "S8.3"
      ],
      "claim": "A context command must retain the actual terminal output or immutable payload reference; the verb alone is not an equivalent prompt."
    },
    {
      "id": "bounded-approval",
      "evidence": [
        "S1.3"
      ],
      "claim": "Approval includes a specific repair, destination boundary and preserved broker conditions. An unqualified approve command would lose authority constraints."
    },
    {
      "id": "closure-is-not-success",
      "evidence": [
        "S3.4",
        "S4.4",
        "S7.6"
      ],
      "claim": "Closeout and archive questions produced handoff or unverified closure reports. These historical replies do not prove successful release or landing."
    }
  ],
