  "new_candidates": [
    {
      "name": "/watch <session> --until <predicate>",
      "contract": "Observe the exact assigned native session within existing deadlines; distinguish terminal non-green from completion; no restart or takeover is implied."
    },
    {
      "name": "/retry <attempt> --changed <evidence>",
      "contract": "Reassess the original attempt only after relevant evidence changes; retain guard stop limits, scope and authority."
    },
    {
      "name": "/record-result <operator-report>",
      "contract": "Preserve the operator's acceptance or factual report as attributed evidence. It does not prove software acceptance or session release."
    }
  ],
  "findings": [
    {
      "id": "same-words-changing-output",
      "evidence": [
        "S1.2",
        "S1.4",
