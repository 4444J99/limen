{
  "schema": "limen.scheduled_process_contracts.v1",
  "processes": {
    "com.limen.heartbeat": {
      "audit": {
        "max_receipts": 96,
        "max_stream_bytes": 262144,
        "public_receipt": "public-latest.json",
        "controller_observation": {
          "owner": "4444J99/domus-genoma",
          "state_root": "~/.local/state/domus/runtime-maintenance",
          "max_state_bytes": 1048576,
          "bookkeeping_only": true,
          "native_state_mutation": false,
          "worker_apply": false
        }
      },
      "command": [
        "limen",
        "heartbeat",
        "--once"
      ],
      "failure_policy": {
        "consecutive_system_failures": 3,
        "disable_with_launchctl": true
      },
      "irf_id": "IRF-SYS-257",
      "launchd": {
        "keep_alive": false,
        "low_priority_io": true,
        "nice": 15,
        "process_type": "Background",
        "run_at_load": false,
        "start_interval_seconds": 180,
        "throttle_interval_seconds": 180
      },
      "limits": {
        "cpu_seconds_per_tick": 60,
        "max_concurrent_probes": 1,
        "max_heavy_probes_per_tick": 1,
        "rss_bytes": 536870912,
        "wall_seconds_per_tick": 120
      },
      "mode": "read_only_one_shot",
      "owner": "4444J99/limen#2528",
      "allowed_effects": [
        "notification_event_v1"
      ],
      "max_notification_events_per_fire": 1,
      "runtime_artifacts": [
        "cli/src/limen/entrypoint.py",
        "cli/src/limen/heartbeat_state.py",
        "cli/pyproject.toml",
        "cli/src/limen/heartbeat.py",
        "cli/src/limen/bounded_subprocess.py",
        "cli/src/limen/host_admission.py",
        "cli/src/limen/notification_effect.py",
        "cli/src/limen/cli.py",
        "scripts/check-beat-freshness.py",
        "scripts/lane-liveness.py",
        "scripts/_board_custody.py",
        "cli/src/limen/private_board.py",
        "cli/src/limen/census.py",
        "cli/src/limen/conduct/client.py",
        "cli/src/limen/models.py",
        "cli/src/limen/runtime_maintenance_observation.py",
        "scripts/runtime-maintenance-observation.py",
        "scripts/tcc-identity-audit",
        "scripts/tcc-identity-audit.py",
        "scripts/protected-tcc-audit.py",
        "spec/runtime-maintenance-observation.json"
      ],
      "probes": [
        {
          "cadence_seconds": 1800,
          "command": [
            "python",
            "scripts/host-pressure-stale.py",
            "--read-only",
            "--on-demand"
          ],
          "cost": "cheap",
          "name": "host-pressure-freshness",
          "timeout_seconds": 15
        },
        {
          "cadence_seconds": 1800,
          "command": [
            "python",
            "scripts/background-items-census.py",
            "--check",
            "--no-receipt"
          ],
          "cost": "cheap",
          "name": "background-items-census",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 1800,
          "command": [
            "python",
            "scripts/check-notification-registry.py"
          ],
          "cost": "cheap",
          "name": "notification-registry-parity",
          "timeout_seconds": 20
        },
        {
          "cadence_seconds": 3600,
          "command": [
            "python",
            "scripts/check-heartbeat-rollout.py",
            "--scheduled-probes"
          ],
          "cost": "cheap",
          "name": "sensor-canary",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 3600,
          "command": [
            "python",
            "scripts/orphan-watchers.py",
            "--check"
          ],
          "cost": "cheap",
          "name": "orphan-watcher",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": [
            "python",
            "scripts/harness-root-probe.py"
          ],
          "cost": "cheap",
          "name": "harness-root-probe",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": [
            "bash",
            "scripts/dialogs-silenced.sh",
            "--agent-curable-only"
          ],
          "cost": "cheap",
          "name": "dialogs-silenced",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": [
            "python",
            "scripts/check-live-checkout.py",
            "--no-receipt"
          ],
          "cost": "cheap",
          "name": "live-checkout-currency",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": [
            "python",
            "scripts/check-notify-gate.py"
          ],
          "cost": "cheap",
          "name": "notify-gate",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 21600,
          "command": [
            "python",
            "scripts/cloud-storage-doctor.py",
            "--check",
            "--no-write"
          ],
          "cost": "heavy",
          "name": "cloud-storage-doctor",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 21600,
          "command": [
            "python",
            "scripts/residue-census.py",
            "--check"
          ],
          "cost": "heavy",
          "name": "residue-census",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 43200,
          "command": [
            "python",
            "scripts/tcc-track-c-closeout.py",
            "--probe",
            "--json",
            "--no-write"
          ],
          "cost": "heavy",
          "name": "tcc-track-c",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 43200,
          "command": [
            "python",
            "scripts/horrevm-custody.py",
            "--status"
          ],
          "cost": "heavy",
          "name": "horrevm-custody",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 86400,
          "command": [
            "bash",
            "scripts/verify-hot-cache.sh"
          ],
          "cost": "heavy",
          "name": "hot-cache",
          "timeout_seconds": 90
        },
        {
          "name": "lane-liveness",
          "command": [
            "python",
            "scripts/lane-liveness.py",
            "--check",
            "--json"
          ],
          "timeout_seconds": 30,
          "cadence_seconds": 7200,
          "cost": "cheap"
        },
        {
          "name": "runtime-maintenance-observation",
          "command": [
            "python",
            "scripts/runtime-maintenance-observation.py"
          ],
          "cadence_seconds": 900,
          "timeout_seconds": 75,
          "cost": "cheap",
          "priority": 100,
          "system_failure_exit_codes": [
            78
          ]
        }
      ],
      "review": {
        "activation_requires_merged_sha": true,
        "contract": "Rule #55a",
        "standard": "organvm-corpvs-testamentvm/docs/standards/18-scheduled-process-contract.md"
      }
    }
  }
}
