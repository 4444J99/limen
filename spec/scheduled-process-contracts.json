{
  "schema": "limen.scheduled_process_contracts.v1",
  "processes": {
    "com.limen.heartbeat": {
      "audit": {
        "max_receipts": 96,
        "max_stream_bytes": 262144,
        "public_receipt": "public-latest.json"
      },
      "command": [
        "limen",
        "heartbeat",
        "--once"
      ],
      "failure_policy": {
        "consecutive_system_failures": 3,
        "disable_with_launchctl": true
      },
      "irf_id": "IRF-SYS-257",
      "launchd": {
        "keep_alive": false,
        "low_priority_io": true,
        "nice": 15,
        "process_type": "Background",
        "run_at_load": false,
        "start_interval_seconds": 300,
        "throttle_interval_seconds": 300
      },
      "limits": {
        "cpu_seconds_per_tick": 60,
        "max_concurrent_probes": 1,
        "max_heavy_probes_per_tick": 1,
        "rss_bytes": 536870912,
        "wall_seconds_per_tick": 120
      },
      "mode": "read_only_one_shot",
      "owner": "organvm/limen#2528",
      "probes": [
        {
          "cadence_seconds": 1800,
          "command": ["python", "scripts/host-pressure-stale.py", "--read-only"],
          "cost": "cheap",
          "name": "host-pressure-freshness",
          "timeout_seconds": 15
        },
        {
          "cadence_seconds": 1800,
          "command": ["python", "scripts/background-items-census.py", "--check", "--no-receipt"],
          "cost": "cheap",
          "name": "background-items-census",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 1800,
          "command": ["python", "scripts/check-notification-registry.py"],
          "cost": "cheap",
          "name": "notification-registry-parity",
          "timeout_seconds": 20
        },
        {
          "cadence_seconds": 3600,
          "command": ["python", "scripts/beat-sensors.py", "--canary"],
          "cost": "cheap",
          "name": "sensor-canary",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 3600,
          "command": ["python", "scripts/orphan-watchers.py", "--check"],
          "cost": "cheap",
          "name": "orphan-watcher",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": ["python", "scripts/harness-root-probe.py"],
          "cost": "cheap",
          "name": "harness-root-probe",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": ["bash", "scripts/dialogs-silenced.sh", "--agent-curable-only"],
          "cost": "cheap",
          "name": "dialogs-silenced",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": ["python", "scripts/check-live-checkout.py", "--no-receipt"],
          "cost": "cheap",
          "name": "live-checkout-currency",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 7200,
          "command": ["python", "scripts/check-notify-gate.py"],
          "cost": "cheap",
          "name": "notify-gate",
          "timeout_seconds": 30
        },
        {
          "cadence_seconds": 21600,
          "command": ["python", "scripts/cloud-storage-doctor.py", "--check", "--no-write"],
          "cost": "heavy",
          "name": "cloud-storage-doctor",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 21600,
          "command": ["python", "scripts/residue-census.py", "--check"],
          "cost": "heavy",
          "name": "residue-census",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 43200,
          "command": ["python", "scripts/tcc-track-c-closeout.py", "--probe", "--json", "--no-write"],
          "cost": "heavy",
          "name": "tcc-track-c",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 43200,
          "command": ["python", "scripts/horrevm-custody.py", "--status"],
          "cost": "heavy",
          "name": "horrevm-custody",
          "timeout_seconds": 90
        },
        {
          "cadence_seconds": 86400,
          "command": ["bash", "scripts/verify-hot-cache.sh"],
          "cost": "heavy",
          "name": "hot-cache",
          "timeout_seconds": 90
        }
      ],
      "review": {
        "activation_requires_merged_sha": true,
        "contract": "Rule #55a",
        "standard": "organvm-corpvs-testamentvm/docs/standards/18-scheduled-process-contract.md"
      }
    }
  }
}
