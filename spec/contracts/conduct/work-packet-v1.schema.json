{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "AgentIdentityV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.agent_identity.v1",
          "default": "limen.agent_identity.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "agent": {
          "title": "Agent",
          "type": "string"
        },
        "surface": {
          "title": "Surface",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "native_run_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Native Run Id"
        },
        "provider_identity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Provider Identity"
        }
      },
      "required": [
        "agent",
        "surface",
        "session_id"
      ],
      "title": "AgentIdentityV1",
      "type": "object"
    },
    "AuthorityEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.authority_envelope.v1",
          "default": "limen.authority_envelope.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "actions": {
          "items": {
            "type": "string"
          },
          "title": "Actions",
          "type": "array",
          "uniqueItems": true
        },
        "repositories": {
          "items": {
            "type": "string"
          },
          "title": "Repositories",
          "type": "array",
          "uniqueItems": true
        },
        "path_prefixes": {
          "items": {
            "type": "string"
          },
          "title": "Path Prefixes",
          "type": "array",
          "uniqueItems": true
        },
        "external_effects": {
          "items": {
            "type": "string"
          },
          "title": "External Effects",
          "type": "array",
          "uniqueItems": true
        },
        "may_delegate": {
          "default": true,
          "title": "May Delegate",
          "type": "boolean"
        }
      },
      "title": "AuthorityEnvelopeV1",
      "type": "object"
    },
    "CampaignPacketV1": {
      "additionalProperties": false,
      "description": "Typed remediation context carried only by institutional campaigns.",
      "properties": {
        "schema_version": {
          "const": "limen.campaign_packet.v1",
          "default": "limen.campaign_packet.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "campaign_id": {
          "title": "Campaign Id",
          "type": "string"
        },
        "failed_predicate": {
          "title": "Failed Predicate",
          "type": "string"
        },
        "owner": {
          "title": "Owner",
          "type": "string"
        },
        "next_action": {
          "title": "Next Action",
          "type": "string"
        },
        "output_ceiling_bytes": {
          "exclusiveMinimum": 0,
          "maximum": 10485760,
          "title": "Output Ceiling Bytes",
          "type": "integer"
        }
      },
      "required": [
        "campaign_id",
        "failed_predicate",
        "owner",
        "next_action",
        "output_ceiling_bytes"
      ],
      "title": "CampaignPacketV1",
      "type": "object"
    },
    "FanoutBoundsV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.fanout_bounds.v1",
          "default": "limen.fanout_bounds.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "max_children": {
          "default": 0,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Children",
          "type": "integer"
        },
        "max_depth": {
          "default": 0,
          "maximum": 64,
          "minimum": 0,
          "title": "Max Depth",
          "type": "integer"
        }
      },
      "title": "FanoutBoundsV1",
      "type": "object"
    },
    "RetryPolicyV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.retry_policy.v1",
          "default": "limen.retry_policy.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "max_attempts": {
          "default": 1,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Attempts",
          "type": "integer"
        },
        "transient_only": {
          "default": true,
          "title": "Transient Only",
          "type": "boolean"
        }
      },
      "title": "RetryPolicyV1",
      "type": "object"
    },
    "SpendEnvelopeV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.spend_envelope.v1",
          "default": "limen.spend_envelope.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "unit": {
          "default": "runs",
          "title": "Unit",
          "type": "string"
        },
        "limit": {
          "default": 1,
          "minimum": 0,
          "title": "Limit",
          "type": "integer"
        },
        "reserve": {
          "default": 0,
          "minimum": 0,
          "title": "Reserve",
          "type": "integer"
        }
      },
      "title": "SpendEnvelopeV1",
      "type": "object"
    },
    "WorkLoanV1": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "external_deadline": {
                "const": true
              }
            },
            "required": [
              "external_deadline"
            ]
          },
          "then": {
            "properties": {
              "due_at": {
                "not": {
                  "type": "null"
                }
              }
            },
            "required": [
              "due_at"
            ]
          }
        }
      ],
      "description": "The collateral required before one bounded run may consume capacity.",
      "properties": {
        "schema_version": {
          "const": "limen.work_loan.v1",
          "default": "limen.work_loan.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "source_origin": {
          "enum": [
            "obligation",
            "human_prompt",
            "agent_recommendation",
            "system_debt"
          ],
          "title": "Source Origin",
          "type": "string"
        },
        "horizon": {
          "enum": [
            "past",
            "present",
            "future"
          ],
          "title": "Horizon",
          "type": "string"
        },
        "value_case": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "^[^\\x00]*[^\\s\\x00][^\\x00]*$",
          "title": "Value Case",
          "type": "string"
        },
        "budget_cost": {
          "exclusiveMinimum": 0,
          "maximum": 1000000,
          "title": "Budget Cost",
          "type": "integer"
        },
        "owner_surface": {
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "^[^\\x00]*[^\\s\\x00][^\\x00]*$",
          "title": "Owner Surface",
          "type": "string"
        },
        "external_deadline": {
          "default": false,
          "title": "External Deadline",
          "type": "boolean"
        },
        "due_at": {
          "anyOf": [
            {
              "format": "date",
              "type": "string"
            },
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Due At"
        }
      },
      "required": [
        "source_origin",
        "horizon",
        "value_case",
        "budget_cost",
        "owner_surface"
      ],
      "title": "WorkLoanV1",
      "type": "object"
    },
    "limen__conduct__models__ResourceClaimV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.resource_claim.v1",
          "default": "limen.resource_claim.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "key": {
          "title": "Key",
          "type": "string"
        },
        "mode": {
          "default": "exclusive",
          "enum": [
            "shared",
            "exclusive"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "key"
      ],
      "title": "ResourceClaimV1",
      "type": "object"
    },
    "limen__prima_materia__ResourceClaimV1": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "limen.prima_materia_resource_claim.v1",
          "default": "limen.prima_materia_resource_claim.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "claim_id": {
          "title": "Claim Id",
          "type": "string"
        },
        "source_instance_id": {
          "title": "Source Instance Id",
          "type": "string"
        },
        "operation_id": {
          "title": "Operation Id",
          "type": "string"
        },
        "hydrated_inputs_bytes": {
          "minimum": 0,
          "title": "Hydrated Inputs Bytes",
          "type": "integer"
        },
        "workspace_bytes": {
          "minimum": 0,
          "title": "Workspace Bytes",
          "type": "integer"
        },
        "temporary_expansion_bytes": {
          "minimum": 0,
          "title": "Temporary Expansion Bytes",
          "type": "integer"
        },
        "output_bytes": {
          "minimum": 0,
          "title": "Output Bytes",
          "type": "integer"
        },
        "encryption_chunking_bytes": {
          "minimum": 0,
          "title": "Encryption Chunking Bytes",
          "type": "integer"
        },
        "rollback_bytes": {
          "minimum": 0,
          "title": "Rollback Bytes",
          "type": "integer"
        },
        "memory_bytes": {
          "minimum": 0,
          "title": "Memory Bytes",
          "type": "integer"
        },
        "file_count": {
          "minimum": 0,
          "title": "File Count",
          "type": "integer"
        },
        "network_bytes": {
          "minimum": 0,
          "title": "Network Bytes",
          "type": "integer"
        },
        "wall_time_seconds": {
          "maximum": 2592000,
          "minimum": 1,
          "title": "Wall Time Seconds",
          "type": "integer"
        },
        "effective_from": {
          "format": "date-time",
          "title": "Effective From",
          "type": "string"
        },
        "effective_until": {
          "format": "date-time",
          "title": "Effective Until",
          "type": "string"
        },
        "rollback_until": {
          "format": "date-time",
          "title": "Rollback Until",
          "type": "string"
        }
      },
      "required": [
        "claim_id",
        "source_instance_id",
        "operation_id",
        "hydrated_inputs_bytes",
        "workspace_bytes",
        "temporary_expansion_bytes",
        "output_bytes",
        "encryption_chunking_bytes",
        "rollback_bytes",
        "memory_bytes",
        "file_count",
        "network_bytes",
        "wall_time_seconds",
        "effective_from",
        "effective_until",
        "rollback_until"
      ],
      "title": "ResourceClaimV1",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "limen.work_packet.v1",
      "default": "limen.work_packet.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "root_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Root Run Id"
    },
    "parent_run_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Parent Run Id"
    },
    "work_id": {
      "title": "Work Id",
      "type": "string"
    },
    "work_key": {
      "title": "Work Key",
      "type": "string"
    },
    "intent": {
      "additionalProperties": true,
      "title": "Intent",
      "type": "object"
    },
    "execution": {
      "additionalProperties": true,
      "title": "Execution",
      "type": "object"
    },
    "intent_hash": {
      "default": "",
      "title": "Intent Hash",
      "type": "string"
    },
    "execution_hash": {
      "default": "",
      "title": "Execution Hash",
      "type": "string"
    },
    "initiator": {
      "$ref": "#/$defs/AgentIdentityV1"
    },
    "conductor": {
      "$ref": "#/$defs/AgentIdentityV1"
    },
    "preferred_agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Preferred Agent"
    },
    "required_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array",
      "uniqueItems": true
    },
    "resource_claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/limen__conduct__models__ResourceClaimV1"
      },
      "title": "Resource Claims",
      "type": "array"
    },
    "storage_envelope_claims": {
      "default": [],
      "items": {
        "$ref": "#/$defs/limen__prima_materia__ResourceClaimV1"
      },
      "title": "Storage Envelope Claims",
      "type": "array"
    },
    "predicate": {
      "title": "Predicate",
      "type": "string"
    },
    "receipt_target": {
      "title": "Receipt Target",
      "type": "string"
    },
    "work_loan": {
      "anyOf": [
        {
          "$ref": "#/$defs/WorkLoanV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "campaign": {
      "anyOf": [
        {
          "$ref": "#/$defs/CampaignPacketV1"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "authority": {
      "$ref": "#/$defs/AuthorityEnvelopeV1"
    },
    "deadline": {
      "format": "date-time",
      "title": "Deadline",
      "type": "string"
    },
    "spend": {
      "$ref": "#/$defs/SpendEnvelopeV1"
    },
    "retry": {
      "$ref": "#/$defs/RetryPolicyV1"
    },
    "depth": {
      "default": 0,
      "maximum": 64,
      "minimum": 0,
      "title": "Depth",
      "type": "integer"
    },
    "fanout": {
      "$ref": "#/$defs/FanoutBoundsV1"
    },
    "effect": {
      "default": "write",
      "enum": [
        "read",
        "write",
        "external"
      ],
      "title": "Effect",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Task Id"
    }
  },
  "required": [
    "work_id",
    "work_key",
    "intent",
    "initiator",
    "conductor",
    "predicate",
    "receipt_target",
    "authority",
    "deadline"
  ],
  "title": "WorkPacketV1",
  "type": "object"
}
