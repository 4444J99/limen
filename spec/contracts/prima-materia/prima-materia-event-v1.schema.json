        "ciphertext_bytes": {
          "minimum": 0,
          "title": "Ciphertext Bytes",
          "type": "integer"
        },
        "ciphertext_sha256": {
          "title": "Ciphertext Sha256",
          "type": "string"
        },
        "encryption_profile_digest": {
          "title": "Encryption Profile Digest",
          "type": "string"
        },
        "object_id": {
          "title": "Object Id",
          "type": "string"
        },
        "schema_version": {
          "const": "limen.encrypted_payload_ref.v1",
          "default": "limen.encrypted_payload_ref.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "object_id",
        "ciphertext_sha256",
        "encryption_profile_digest",
        "chunk_manifest_digest",
        "ciphertext_bytes"
