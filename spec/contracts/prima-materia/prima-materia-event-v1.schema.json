    "event_id": {
      "title": "Event Id",
      "type": "string"
    },
    "input_digests": {
      "items": {
        "type": "string"
      },
      "maxItems": 1024,
      "title": "Input Digests",
      "type": "array"
    },
    "intent_event_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 1024,
      "title": "Intent Event Ids",
      "type": "array"
