          "items": {
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Access Scope",
          "type": "array"
        },
        "consent_receipt_ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consent Receipt Ref"
        },
        "policy_digest": {
          "title": "Policy Digest",
          "type": "string"
        },
        "publication_requires_receipt": {
          "default": true,
          "title": "Publication Requires Receipt",
          "type": "boolean"
        },
        "purpose": {
          "maxLength": 4096,
          "minLength": 1,
          "title": "Purpose",
          "type": "string"
        },
        "schema_version": {
          "const": "limen.privacy_consent_policy.v1",
          "default": "limen.privacy_consent_policy.v1",
          "title": "Schema Version",
          "type": "string"
        }
      },
      "required": [
        "policy_digest",
        "purpose",
        "access_scope"
      ],
      "title": "PrivacyConsentPolicyV1",
      "type": "object"
    }
  },
