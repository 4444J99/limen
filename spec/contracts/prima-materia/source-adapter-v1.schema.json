{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_id": {
      "title": "Adapter Id",
      "type": "string"
    },
    "claim_recipe": {
      "title": "Claim Recipe",
      "type": "string"
    },
    "completeness_predicate": {
      "title": "Completeness Predicate",
      "type": "string"
    },
    "cursor_schema_digest": {
      "title": "Cursor Schema Digest",
      "type": "string"
    },
    "custody_target_refs": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "Custody Target Refs",
      "type": "array"
    },
    "owner_ref": {
      "title": "Owner Ref",
      "type": "string"
    },
    "privacy_transform_digest": {
      "title": "Privacy Transform Digest",
      "type": "string"
    },
    "recipe_version": {
      "title": "Recipe Version",
      "type": "string"
    },
    "restoration_predicate": {
      "title": "Restoration Predicate",
      "type": "string"
    },
    "schema_version": {
      "const": "limen.source_adapter.v1",
      "default": "limen.source_adapter.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_id": {
      "title": "Source Id",
      "type": "string"
    },
    "source_native_acquisition": {
      "title": "Source Native Acquisition",
      "type": "string"
    }
  },
  "required": [
    "adapter_id",
    "source_id",
    "owner_ref",
    "source_native_acquisition",
    "cursor_schema_digest",
    "completeness_predicate",
    "privacy_transform_digest",
    "claim_recipe",
    "recipe_version",
    "custody_target_refs",
    "restoration_predicate"
  ],
  "title": "SourceAdapterV1",
  "type": "object"
}
