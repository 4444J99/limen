{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "missing_adapter_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Missing Adapter Source Ids",
      "type": "array"
    },
    "observed_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Observed Source Ids",
      "type": "array"
    },
    "registered_source_ids": {
      "items": {
        "type": "string"
      },
      "title": "Registered Source Ids",
      "type": "array"
    },
    "registry_digest": {
      "title": "Registry Digest",
      "type": "string"
    },
    "schema_version": {
      "const": "limen.source_coverage.v1",
