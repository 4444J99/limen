{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "claim_id": {
      "title": "Claim Id",
      "type": "string"
    },
    "effective_from": {
      "format": "date-time",
      "title": "Effective From",
      "type": "string"
    },
    "effective_until": {
      "format": "date-time",
      "title": "Effective Until",
      "type": "string"
    },
    "encryption_chunking_bytes": {
      "minimum": 0,
      "title": "Encryption Chunking Bytes",
      "type": "integer"
    },
    "file_count": {
      "minimum": 0,
      "title": "File Count",
      "type": "integer"
    },
    "hydrated_inputs_bytes": {
      "minimum": 0,
      "title": "Hydrated Inputs Bytes",
      "type": "integer"
    },
    "memory_bytes": {
      "minimum": 0,
      "title": "Memory Bytes",
      "type": "integer"
    },
    "network_bytes": {
      "minimum": 0,
      "title": "Network Bytes",
      "type": "integer"
    },
    "operation_id": {
      "title": "Operation Id",
      "type": "string"
    },
    "output_bytes": {
      "minimum": 0,
      "title": "Output Bytes",
      "type": "integer"
    },
    "rollback_bytes": {
      "minimum": 0,
      "title": "Rollback Bytes",
      "type": "integer"
    },
    "rollback_until": {
      "format": "date-time",
      "title": "Rollback Until",
      "type": "string"
    },
    "schema_version": {
      "const": "limen.prima_materia_resource_claim.v1",
      "default": "limen.prima_materia_resource_claim.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "source_instance_id": {
      "title": "Source Instance Id",
      "type": "string"
    },
    "temporary_expansion_bytes": {
      "minimum": 0,
      "title": "Temporary Expansion Bytes",
      "type": "integer"
    },
    "wall_time_seconds": {
      "maximum": 2592000,
      "minimum": 1,
      "title": "Wall Time Seconds",
      "type": "integer"
    },
    "workspace_bytes": {
      "minimum": 0,
      "title": "Workspace Bytes",
      "type": "integer"
    }
  },
  "required": [
    "claim_id",
    "source_instance_id",
    "operation_id",
    "hydrated_inputs_bytes",
    "workspace_bytes",
    "temporary_expansion_bytes",
    "output_bytes",
    "encryption_chunking_bytes",
    "rollback_bytes",
    "memory_bytes",
    "file_count",
    "network_bytes",
    "wall_time_seconds",
    "effective_from",
    "effective_until",
    "rollback_until"
  ],
  "title": "ResourceClaimV1",
  "type": "object"
}
