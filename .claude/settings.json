{
  "plansDirectory": "docs/plans",
  "permissions": {
    "defaultMode": "plan",
    "allow": [
      "Bash(launchctl list *)",
      "mcp__claude-in-chrome__tabs_context_mcp",
      "mcp__claude-in-chrome__read_network_requests",
      "mcp__claude_ai_Google_Drive__search_files",
      "mcp__claude_ai_Gmail__search_threads",
      "mcp__claude_ai_Gmail__get_thread",
      "mcp__claude_ai_Google_Calendar__list_events",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git rebase *)",
      "Bash(git pull *)",
      "Bash(git worktree *)",
      "Bash(git restore *)",
      "Bash(git branch *)",
      "Bash(gh api *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(sqlite3 *)",
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr checkout *)",
      "Bash(gh pr ready *)",
      "Bash(gh run watch *)",
      "Bash(gh run rerun *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(bash scripts/verify-scoped.sh *)",
      "Bash(bash scripts/merge-policy.sh *)",
      "Bash(scripts/merge-policy.sh *)",
      "Bash(bash scripts/tests/*)",
      "Bash(python3 scripts/gitvs.py *)",
      "Bash(python3 scripts/beat-sensors.py *)",
      "Bash(python3 scripts/check-params.py)",
      "Bash(python3 scripts/check-sensors.py)",
      "Bash(python3 -m py_compile *)",
      "Bash(python3 -m pytest *)",
      "Bash(python3 -m ruff *)",
      "Bash(mkdir *)",
      "Bash(chmod +x *)",
      "mcp__claude_ai_Gmail__get_message",
      "mcp__claude_ai_Gmail__list_drafts",
      "mcp__claude_ai_Gmail__list_labels",
      "mcp__claude-in-chrome__read_page",
      "mcp__claude-in-chrome__find",
      "Bash(python3 scripts/host-work-admission.py status *)",
      "Bash(python3 scripts/host-work-admission.py status)",
      "Bash(python3 scripts/host-work-admission.py capabilities)",
      "Bash(python3 scripts/host-work-admission.py --help)",
      "mcp__claude-in-chrome__list_connected_browsers",
      "Bash(chezmoi diff *)",
      "Bash(shasum *)",
      "Bash(bash scripts/run-pytest-hermetic.sh *)",
      "Bash(bash /Users/4jp/Workspace/limen/scripts/merge-policy.sh *)",
      "Bash(claude --version)",
      "Bash(claude plugin list *)",
      "Bash(chezmoi source-path *)",
      "Bash(chezmoi managed *)",
      "Bash(/Users/4jp/.local/bin/domus-limen-runtime verify-heartbeat *)",
      "Bash(/Users/4jp/.local/bin/domus-limen-runtime plan-heartbeat *)",
      "Bash(/Users/4jp/.local/bin/domus-limen-runtime status *)",
      "Bash(scripts/verify-scoped.sh *)",
      "mcp__claude-in-chrome__get_page_text",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_pr__get_status"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/session-orient.sh\" ] && LIMEN_ROOT=\"$PROJECT_ROOT\" \"$PROJECT_ROOT/scripts/hooks/session-orient.sh\" || true"
          },
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/conduct-register.sh\" ] && \"$PROJECT_ROOT/scripts/hooks/conduct-register.sh\" || true",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/worktree-commit-guard.sh\" ] && LIMEN_ROOT=\"$PROJECT_ROOT\" \"$PROJECT_ROOT/scripts/hooks/worktree-commit-guard.sh\" || true"
          },
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/pytest-scope-guard.sh\" ] && LIMEN_ROOT=\"$PROJECT_ROOT\" \"$PROJECT_ROOT/scripts/hooks/pytest-scope-guard.sh\" || true"
          },
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/no-hand-poll-guard.sh\" ] && LIMEN_ROOT=\"$PROJECT_ROOT\" \"$PROJECT_ROOT/scripts/hooks/no-hand-poll-guard.sh\" || true"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/lint-edited-file.sh\" ] && LIMEN_ROOT=\"$PROJECT_ROOT\" \"$PROJECT_ROOT/scripts/hooks/lint-edited-file.sh\" || true"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; [ -x \"$PROJECT_ROOT/scripts/hooks/conduct-register.sh\" ] && \"$PROJECT_ROOT/scripts/hooks/conduct-register.sh\" || true",
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "PROJECT_ROOT=\"${CLAUDE_PROJECT_DIR:-$PWD}\"; if [ ! -x \"$PROJECT_ROOT/scripts/hooks/session-closeout.sh\" ]; then PROJECT_ROOT=\"${LIMEN_LIVE_ROOT:-$HOME/Workspace/limen}\"; fi; [ -x \"$PROJECT_ROOT/scripts/hooks/session-closeout.sh\" ] && LIMEN_ROOT=\"$PROJECT_ROOT\" \"$PROJECT_ROOT/scripts/hooks/session-closeout.sh\" || true",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
