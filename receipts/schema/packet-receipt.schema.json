{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collaboration Operations Packet Receipt",
  "type": "object",
  "required": ["status", "packet_id", "run_id", "predicate", "checks", "changed_paths", "outcome"],
  "properties": {
    "status": {"type": "string", "enum": ["done", "failed", "failed_blocked", "needs_human"]},
    "packet_id": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"},
    "run_id": {"type": "string", "minLength": 3},
    "lease_id": {"type": "string"},
    "lease_generation": {"type": "integer", "minimum": 0},
    "executor": {"type": "string"},
    "predicate": {"type": "string"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "skip"]
          }
        },
        "additionalProperties": true
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {"type": "string"}
    },
    "observed_heads_before": {"type": "object"},
    "observed_heads_after": {"type": "object"},
    "spend": {"type": "object", "additionalProperties": {"type": "number"}},
    "outcome": {"type": "string"}
  },
  "additionalProperties": true
}
