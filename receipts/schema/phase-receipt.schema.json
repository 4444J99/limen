{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Collaboration Operations Phase Receipt",
  "type": "object",
  "required": ["status", "phase_id", "observed_heads", "checks", "packets"],
  "properties": {
    "status": {"type": "string", "enum": ["done", "failed", "failed_blocked", "needs_human"]},
    "phase_id": {"type": "string", "pattern": "^[a-z]+$"},
    "observed_heads": {"type": "object"},
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["command", "status"],
        "properties": {
          "command": {"type": "string"},
          "status": {"type": "string", "enum": ["pass", "fail", "skip"]}
        },
        "additionalProperties": true
      }
    },
    "packets": {
      "type": "array",
      "items": {"type": "string", "pattern": "^[A-Z]+-[0-9]{2}$"}
    },
    "outcome": {"type": "string"}
  },
  "additionalProperties": true
}
