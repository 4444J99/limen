<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  ianva gateway keepalive (LaunchAgent), mirroring com.limen.heartbeat.

  INSTALL: verify the receipt-bound Domus runtime and Rule #55a admission first.
  Keep an active gateway protected until its clients drain; then use its owner lifecycle.
  Create the private bounded-log state directory before loading this reviewed plist.
  Historical commands (not an admission boundary):
    cp deploy/com.ianva.gateway.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.ianva.gateway.plist
  RESTART:  launchctl kickstart -k gui/$(id -u)/com.ianva.gateway
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.ianva.gateway</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/4jp/.local/share/limen/current/source/ianva/scripts/ianva-serve.sh</string>
  </array>
  <key>RunAtLoad</key>        <true/>
  <key>KeepAlive</key>        <true/>
  <key>ThrottleInterval</key> <integer>10</integer>
  <key>StandardOutPath</key>  <string>/Users/4jp/.local/state/limen/launchd/gateway.out.log</string>
  <key>StandardErrorPath</key><string>/Users/4jp/.local/state/limen/launchd/gateway.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/Users/4jp/.local/share/limen/current/venv/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
  </dict>
</dict>
</plist>
