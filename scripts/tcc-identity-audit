#!/bin/sh
set -eu

root="$(unset CDPATH; cd -- "$(dirname "$0")/.." && pwd -P)"
implementation="$root/scripts/tcc-identity-audit.py"
strict=0
for argument in "$@"; do
  if [ "$argument" = "--strict" ]; then
    strict=1
    break
  fi
done
python="$(command -v python3 2>/dev/null || true)"
if [ -z "$python" ]; then
  if [ "$strict" -eq 1 ]; then
    printf 'tcc-identity-audit: Python 3 is unavailable\n' >&2
    exit 69
  fi
  printf 'tcc-identity-audit: SKIP: Python 3 is unavailable\n' >&2
  exit 0
fi
if [ "$(uname -s)" != "Darwin" ]; then
  exec "$python" "$implementation" "$@"
fi
host_lifetime_fd="${DOMUS_AGENT_HOST_LIFETIME_FD:-}"
host_active=0
case "$host_lifetime_fd" in
  "" | *[!0-9]*) ;;
  *)
    [ -e "/dev/fd/$host_lifetime_fd" ] && host_active=1
    ;;
esac
if [ "${DOMUS_AGENT_HOST_ACTIVE:-}" = "1" ] && [ "$host_active" -eq 1 ]; then
  exec "$python" "$implementation" "$@"
fi
host="${DOMUS_AGENT_HOST_BIN:-$HOME/Applications/DomusAgentHost.app/Contents/MacOS/DomusAgentHost}"
if [ ! -x "$host" ]; then
  printf 'tcc-identity-audit: stable Domus agent host is unavailable: %s\n' "$host" >&2
  exit 69
fi
exec "$host" run -- "$python" "$implementation" "$@"
